{
  "name": "sagebridge-api",
  "version": "1.0.0",
  "description": "SageBridge Cloudflare Workers API - Multi-tenant Sage 50 mobile backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute sagebridge-db --file=./schema.sql",
    "db:create": "wrangler d1 create sagebridge-db",
    "tail": "wrangler tail",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts"
  },
  "keywords": ["cloudflare", "workers", "sage50", "api"],
  "author": "SageBridge",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "wrangler": "^3.57.0",
    "typescript": "^5.4.5"
  }
}
